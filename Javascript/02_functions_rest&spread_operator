//Usage of rest and spread operator.

function greet(){
    console.log("Hello,...!!");
}
greet();

function addNumber(num1, num2, num3=0, num4=0){
    res = num1+num2+num3+num4;
    console.log(res);
}
addNumber(3,8);
addNumber(4,6,7);
addNumber(6,17,26,43);

function addNum(...num){
    let res=0;
    for (let n of num){
        res += n;
    }
    console.log(res);
}
addNum(3,8);
addNum(4,6,7);
addNum(6,17,26,43);

